; invaders-36.mic - Space Invaders fuer Busch Microtronic 2090 mit 8x8-LED-Matrix und 3 Tastern
; 254 Schritte (00-FD), frei: 2
; Start: Reset (alle Register 0, das Programm enthaelt kein CLEAR), Matrix einschalten, RUN.
; Taster: Eingang 2 = links, Eingang 3 = Feuer, Eingang 4 = rechts (Emulator: Pfeiltasten).
;   Eingang 1 gehoert der Matrix (REQ des ESP2090 Studios). Taster halten, bis das Schiff reagiert.
; Spielende (Bombe trifft das Schiff): Punkte dezimal in der Anzeige. Neues Spiel: Reset.
; Version 36: Bildausgabe fuer das ESP2090 Studio (REQ/ACK, Blockmodus ACK 1, genau ein Befehl zwischen ACK
;   und erstem Wert). Fenster nur noch EXRA, EXRL (DOT-Reihenfolge angepasst): 2 Schritte weniger, ab 4F um 2
;   verschoben. Grundlage: Listing von invaders-35.xml.
; Matrix: LED on in der Weboberflaeche (Emulator2090: m, Modus ESP).
;
; #define (Register)
;   SCHIFF1 r0  SCHIFF2 r1  Schiff links/rechts (Zeile 1)
;   Z11-Z42 r0-r7  Zeile 1-4; im EXRL-Fenster Zeile 5-8
;   ALIENS r8  LAGE r9  RAKETE_Y rA  RAKETE_L rB  RAKETE_R rC   (Kontext Rakete)
;   PUNKTE_L r8  PUNKTE_H r9  BOMBE_Y rA  BOMBE_L rB  BOMBE_R rC  (Kontext Bombe, nach EXRM)
;   TREFFER/ZUFALL/TEST rD  HILF rE  FENSTER/EINGABE rF

F02   ; 00  Beginn     DISOUT           Display aus: Befehle 9,3 ms (Frame-Takt der Matrix), schon fürs Schiff
180   ; 01             MOVI #8,SCHIFF1  Schiff Spalte 4-6
131   ; 02             MOVI #3,SCHIFF2
F0D   ; 03  Füllen     EXRL             Fenster auf: R0-R7 = Aliens (leer), Schiff und Rest sind in M0-M7 geparkt
156   ; 04             MOVI #5,Z41      Aliens verteilen (Zeile 8)
157   ; 05             MOVI #5,Z42
1A4   ; 06             MOVI #A,Z31
125   ; 07             MOVI #2,Z32
152   ; 08             MOVI #5,Z21
153   ; 09             MOVI #5,Z22
F0D   ; 0A             EXRL             Aliens nach M0-M7 (Zeile 6-8), Schiff, Rakete und Bombe sind zurück
1B8   ; 0B             MOVI #B,ALIENS   11 Aliens (Zeile 6-8)
379   ; 0C             ANDI #7,LAGE     Startlage (Bit 4 = 0), die Punkte in Bit 1-3 bleiben
FDF   ; 0D  Start      DIN EINGABE
3EF   ; 0E             ANDI #E,EINGABE  Eingang 1 (Bereit-Signal der Matrix) ausblenden
E35   ; 0F             BRZ Anzeige      keine Taste
0FD   ; 10             MOV EINGABE,TEST zuerst Feuer: Eingang 3
34D   ; 11             ANDI #4,TEST
E22   ; 12             BRZ Dir          kein Feuer
90A   ; 13  FireB      CMPI #0,RAKETE_Y Rakete schon unterwegs?
D22   ; 14             BRC Dir
00B   ; 15             MOV SCHIFF1,RAKETE_L Mitte des sichtbaren Schiffs (vor dem Zug) = linkes Ende + 1:
01C   ; 16             MOV SCHIFF2,RAKETE_R
FAC   ; 17             SHL RAKETE_R     Schiff um 1 nach rechts
FAB   ; 18             SHL RAKETE_L
FBC   ; 19             ADC RAKETE_R
F8B   ; 1A             INV RAKETE_L     und nicht
F8C   ; 1B             INV RAKETE_R
20B   ; 1C             AND SCHIFF1,RAKETE_L = linkes Ende des Schiffs
21C   ; 1D             AND SCHIFF2,RAKETE_R
FAC   ; 1E             SHL RAKETE_R     ein Feld nach rechts = Mitte
FAB   ; 1F             SHL RAKETE_L
FBC   ; 20             ADC RAKETE_R
11A   ; 21             MOVI #1,RAKETE_Y Rakete startet in Zeile 1 (im Schiff, nicht gezeichnet)
3AF   ; 22  Dir        ANDI #A,EINGABE  Richtung: Eingang 4 (8) = rechts, Eingang 2 (2) = links
98F   ; 23             CMPI #8,EINGABE  nur rechts
E28   ; 24             BRZ RechtsB
92F   ; 25             CMPI #2,EINGABE  nur links
E2E   ; 26             BRZ LinksB
C35   ; 27             GOTO Anzeige     keine Richtung oder beide: Schiff bleibt stehen
971   ; 28  RechtsB    CMPI #7,SCHIFF2  Schiff steht rechts am Rand?
D35   ; 29             BRC Anzeige
FA1   ; 2A             SHL SCHIFF2      Schiff ein Feld nach rechts
FA0   ; 2B             SHL SCHIFF1
FB1   ; 2C             ADC SCHIFF2
C35   ; 2D             GOTO Anzeige
970   ; 2E  LinksB     CMPI #7,SCHIFF1  Schiff steht links am Rand (Spalte 1-3)?
E35   ; 2F             BRZ Anzeige      ja: kein Zug
F90   ; 30             SHR SCHIFF1      Schiff ein Feld nach links
F91   ; 31             SHR SCHIFF2
D34   ; 32             BRC Plus8        Carry (Spalte 5) nach SCHIFF1 Bit 4
C35   ; 33             GOTO Anzeige
580   ; 34  Plus8      ADDI #8,SCHIFF1
F0F   ; 35  Anzeige    EXRA             Fenster: R0-R7 = Variablen (TEST jetzt in r5), R8-RF = Zeile 1-4
FD5   ; 36  AnzW       DIN r5           auf REQ des ESP2090 (Eingang 1) warten
315   ; 37             ANDI #1,r5
E36   ; 38             BRZ AnzW
FE5   ; 39             DOT r5           ACK 1 = Blockmodus
F0D   ; 3A             EXRL             genau EIN Befehl zwischen ACK und erstem Wert: R0-R7 = Zeile 5-8
FE8   ; 3B             DOT Z11          Zeile 1-4 (in R8-RF)
FE9   ; 3C             DOT Z12
FEA   ; 3D             DOT Z21
FEB   ; 3E             DOT Z22
FEC   ; 3F             DOT Z31
FED   ; 40             DOT Z32
FEE   ; 41             DOT Z41
FEF   ; 42             DOT Z42
FE0   ; 43             DOT Z51          Zeile 5-8 (in R0-R7)
FE1   ; 44             DOT Z52
FE2   ; 45             DOT Z61
FE3   ; 46             DOT Z62
FE4   ; 47             DOT Z71
FE5   ; 48             DOT Z72
FE6   ; 49             DOT Z81
FE7   ; 4A             DOT Z82
F0D   ; 4B             EXRL             Fenster zu (umgekehrte Reihenfolge)
F0F   ; 4C             EXRA
10D   ; 4D             MOVI #0,TEST     Ausgaenge auf 0: Uebertragung fertig, naechstes ACK moeglich
FED   ; 4E             DOT TEST
90A   ; 4F  Rakete     CMPI #0,RAKETE_Y
E65   ; 50             BRZ Bombe        keine Rakete
91A   ; 51             CMPI #1,RAKETE_Y
E54   ; 52             BRZ NeuR         Zeile 1 ist nicht gezeichnet
BC9   ; 53             CALL Toggle      Rakete aus der alten Zeile löschen (XOR)
51A   ; 54  NeuR       ADDI #1,RAKETE_Y eine Zeile höher
98A   ; 55             CMPI #8,RAKETE_Y
D64   ; 56             BRC Oben8        Zeile 9: oben raus
BC9   ; 57             CALL Toggle      neue Zeile: setzt die Rakete oder löscht das getroffene Ziel
E65   ; 58             BRZ Bombe        kein Treffer (Toggle liefert das Zero-Flag)
95A   ; 59  Hit        CMPI #5,RAKETE_Y
D5D   ; 5A             BRC AlienHit     Zeile 6-8: Alien getroffen
F0E   ; 5B             EXRM             Zeile 2-5: Bombe getroffen, beide weg
C73   ; 5C             GOTO Kolli
0AD   ; 5D  AlienHit   MOV RAKETE_Y,TEST Zeilenpunkte: Zeile 6 = 1, 7 = 2, 8 = 3
75D   ; 5E             SUBI #5,TEST
F7D   ; 5F             MAS TEST         über M13 in den Kontext Bombe: nach EXRM steht der Wert in TEST
F0E   ; 60             EXRM             Kontext Bombe: dort liegen die Punkte (r8, r9)
BC3   ; 61             CALL Punkt       kommt im Kontext Rakete zurück, Rakete ist weg
718   ; 62             SUBI #1,ALIENS   Ziel ist schon gelöscht, die Rakete wird nicht gesetzt
E03   ; 63             BRZ Füllen       alle Aliens weg: neue Aliens, Schiff und Bombe bleiben
10A   ; 64  Oben8      MOVI #0,RAKETE_Y Rakete weg
F0E   ; 65  Bombe      EXRM             rA/rB/rC = Bombe, Toggle arbeitet auf rA/rB/rC
90A   ; 66             CMPI #0,BOMBE_Y
E78   ; 67             BRZ BombeNeu     keine Bombe
F05   ; 68             RND              fällt die Bombe in diesem Tick? Chance (5 + Stufe)/16, ab Stufe 11 immer
74D   ; 69             SUBI #4,ZUFALL   Würfel 0-3: fällt (Startwert der Kurve: SUBI #k ergibt (k + 1 + Stufe)/16)
D6D   ; 6A             BRC Fallen
89D   ; 6B             CMP PUNKTE_H,ZUFALL Carry = Stufe < Würfel - 4: bleibt diesen Tick stehen
D9D   ; 6C             BRC BombeEnde
BC9   ; 6D  Fallen     CALL Toggle      Bombe aus der alten Zeile löschen
71A   ; 6E             SUBI #1,BOMBE_Y  eine Zeile tiefer
91A   ; 6F             CMPI #1,BOMBE_Y
E8D   ; 70             BRZ BombeUnten   Zeile 1: Schiff prüfen
BC9   ; 71             CALL Toggle      neue Zeile: setzt die Bombe oder löscht die getroffene Rakete
E9D   ; 72             BRZ BombeEnde
16D   ; 73  Kolli      MOVI #6,TEST     Bombe und Rakete getroffen: 6 - Zeile Punkte (Zeile 5 = 1 ... Zeile 2 = 4), beide weg
6AD   ; 74             SUB BOMBE_Y,TEST BOMBE_Y ist hier immer die Zeile des Zusammenstoßes
10A   ; 75             MOVI #0,BOMBE_Y
BC3   ; 76             CALL Punkt       kommt im Kontext Rakete zurück, Rakete ist weg
C9E   ; 77             GOTO Aliens
F05   ; 78  BombeNeu   RND              neue Bombe? Stufe = PUNKTE_H (wächst alle 16 Punkte), Schwelle = 2 * Stufe
09E   ; 79             MOV PUNKTE_H,HILF Chance (2 * Stufe + 1)/16: Stufe 0: 1/16, 1: 3/16 ... 7: 15/16, ab Stufe 8 immer
FAE   ; 7A             SHL HILF
D7E   ; 7B             BRC BombeStart   Überlauf: Stufe >= 8 (ab 128 Punkten), immer eine neue Bombe
8ED   ; 7C             CMP HILF,ZUFALL  Carry = Schwelle < Würfel: keine Bombe
D9D   ; 7D             BRC BombeEnde
15A   ; 7E  BombeStart MOVI #5,BOMBE_Y  Bombe startet in Zeile 5 ...
FCA   ; 7F             SUBC BOMBE_Y     ... ab Stufe 8 in Zeile 4 (Carry = 1 nur über den Überlauf-Sprung)
11B   ; 80             MOVI #1,BOMBE_L
10C   ; 81             MOVI #0,BOMBE_R
0FE   ; 82             MOV FENSTER,HILF Spalte 0-7 aus dem Zufall (F-Ziffer)
37E   ; 83             ANDI #7,HILF
71E   ; 84  SpLoop     SUBI #1,HILF
D8A   ; 85             BRC SpEnde
FAC   ; 86             SHL BOMBE_R
FAB   ; 87             SHL BOMBE_L
FBC   ; 88             ADC BOMBE_R
C84   ; 89             GOTO SpLoop
BC9   ; 8A  SpEnde     CALL Toggle      Bombe zeichnen (trifft sie dabei die Rakete: beide weg)
E9D   ; 8B             BRZ BombeEnde
C73   ; 8C             GOTO Kolli
00D   ; 8D  BombeUnten MOV Z11,TREFFER  Zeile 1 = Schiff: Treffer = Schiff UND Bombe, ohne Toggle
2BD   ; 8E             AND BOMBE_L,TREFFER
01E   ; 8F             MOV Z12,HILF
2CE   ; 90             AND BOMBE_R,HILF
AED   ; 91             OR HILF,TREFFER
E9C   ; 92             BRZ Miss         kein Treffer
085   ; 93  GameOver   MOV PUNKTE_L,Z32 Spielende: Einer und Sechzehner nach R5/R6 (EXRM tauscht die nicht)
096   ; 94             MOV PUNKTE_H,Z41
F0E   ; 95             EXRM             Kontext Rakete: dritte Stelle steckt in LAGE
097   ; 96             MOV LAGE,Z42     dritte Stelle nach R7
377   ; 97             ANDI #7,Z42      Bit 4 (Alienlage) ausblenden
F0F   ; 98             EXRA             R5 R6 R7 -> D E F (Einer, Sechzehner, 256er)
F03   ; 99             HXDZ             D E F = Einer, Zehner, Hunderter
F3D   ; 9A             DISP #3,TEST
C9B   ; 9B  Ende       GOTO Ende        bleibt stehen (Reset für neues Spiel)
10A   ; 9C  Miss       MOVI #0,BOMBE_Y  Bombe verfehlt das Schiff
F0E   ; 9D  BombeEnde  EXRM             Kontext Rakete
F05   ; 9E  Aliens     RND
95A   ; 9F             CMPI #5,RAKETE_Y
D0D   ; A0             BRC Start        Rakete in Zeile 6-8: Aliens bleiben stehen
91D   ; A1             CMPI #1,ZUFALL
D0D   ; A2             BRC Start        nur in 1 von 8 Ticks bewegen (Würfel 0 oder 1)
979   ; A3  Sway       CMPI #7,LAGE     Carry = Bit 4 gesetzt: Block steht rechts
DB0   ; A4             BRC SwayL        Block steht rechts: ein Feld nach links
F0D   ; A5             EXRL             Block steht in Startlage: ein Feld nach rechts (Aliens in R0-R7)
FA3   ; A6             SHL Z22
FA2   ; A7             SHL Z21
FB3   ; A8             ADC Z22
FA5   ; A9             SHL Z32
FA4   ; AA             SHL Z31
FB5   ; AB             ADC Z32
FA7   ; AC             SHL Z42
FA6   ; AD             SHL Z41
FB7   ; AE             ADC Z42
CBA   ; AF             GOTO SwayEnde
F0D   ; B0  SwayL      EXRL
F92   ; B1             SHR Z21          Zeile 6 (Zeile 5 ist frei und wird nicht geschoben)
F93   ; B2             SHR Z22
DBD   ; B3             BRC Fix6         Übertrag Spalte 5 -> Spalte 4
F94   ; B4  Back6      SHR Z31
F95   ; B5             SHR Z32
DBF   ; B6             BRC Fix7         Übertrag Spalte 5 -> Spalte 4
F96   ; B7  Back7      SHR Z41
F97   ; B8             SHR Z42
DC1   ; B9             BRC Fix8         Übertrag Spalte 5 -> Spalte 4
F0D   ; BA  SwayEnde   EXRL
589   ; BB             ADDI #8,LAGE     Lage wechseln (nur Bit 4)
C0D   ; BC             GOTO Start
582   ; BD  Fix6       ADDI #8,Z21
CB4   ; BE             GOTO Back6
584   ; BF  Fix7       ADDI #8,Z31
CB7   ; C0             GOTO Back7
586   ; C1  Fix8       ADDI #8,Z41
CBA   ; C2             GOTO SwayEnde
4D8   ; C3  Punkt      ADD TEST,PUNKTE_L TEST Punkte: dreistellig = r8, r9 (Bombenseite) und LAGE Bit 1-3 (Raketenseite)
FB9   ; C4             ADC PUNKTE_H
F0E   ; C5             EXRM             Carry bleibt über EXRM erhalten
10A   ; C6             MOVI #0,RAKETE_Y Rakete ist in beiden Fällen weg
FB9   ; C7             ADC LAGE
F07   ; C8             RET
94A   ; C9  Toggle     CMPI #4,RAKETE_Y Zeile 5-8?
DFA   ; CA             BRC TgUp
10F   ; CB             MOVI #0,FENSTER  Zeile 1-4: Fenster bleibt zu
92A   ; CC  TgZeile    CMPI #2,RAKETE_Y Halbierungssuche: Carry = Zeile 3/4, Zero = Zeile 2, sonst Zeile 1
DD8   ; CD             BRC TgHi
EE8   ; CE             BRZ TgZ2
00D   ; CF  TgZ1       MOV Z11,TREFFER  links: Treffer = Zeile und Maske
2BD   ; D0             AND RAKETE_L,TREFFER
AB0   ; D1             OR RAKETE_L,Z11  XOR = (a oder m) - (a und m)
6D0   ; D2             SUB TREFFER,Z11
01E   ; D3             MOV Z12,HILF     rechts
2CE   ; D4             AND RAKETE_R,HILF
AC1   ; D5             OR RAKETE_R,Z12
6E1   ; D6             SUB HILF,Z12
CE2   ; D7             GOTO TgEnde
93A   ; D8  TgHi       CMPI #3,RAKETE_Y Zeile 3 oder 4
EF1   ; D9             BRZ TgZ3
06D   ; DA  TgZ4       MOV Z41,TREFFER  links: Treffer = Zeile und Maske
2BD   ; DB             AND RAKETE_L,TREFFER
AB6   ; DC             OR RAKETE_L,Z41  XOR = (a oder m) - (a und m)
6D6   ; DD             SUB TREFFER,Z41
07E   ; DE             MOV Z42,HILF     rechts
2CE   ; DF             AND RAKETE_R,HILF
AC7   ; E0             OR RAKETE_R,Z42
6E7   ; E1             SUB HILF,Z42
90F   ; E2  TgEnde     CMPI #0,FENSTER
EE6   ; E3             BRZ TgRet
54A   ; E4             ADDI #4,RAKETE_Y Zeile zurückrechnen, Fenster zu
F0D   ; E5             EXRL
AED   ; E6  TgRet      OR HILF,TREFFER  beide Hälften: Treffer <> 0 (Zero-Flag bleibt für den Aufrufer)
F07   ; E7             RET
02D   ; E8  TgZ2       MOV Z21,TREFFER  links: Treffer = Zeile und Maske
2BD   ; E9             AND RAKETE_L,TREFFER
AB2   ; EA             OR RAKETE_L,Z21  XOR = (a oder m) - (a und m)
6D2   ; EB             SUB TREFFER,Z21
03E   ; EC             MOV Z22,HILF     rechts
2CE   ; ED             AND RAKETE_R,HILF
AC3   ; EE             OR RAKETE_R,Z22
6E3   ; EF             SUB HILF,Z22
CE2   ; F0             GOTO TgEnde
04D   ; F1  TgZ3       MOV Z31,TREFFER  links: Treffer = Zeile und Maske
2BD   ; F2             AND RAKETE_L,TREFFER
AB4   ; F3             OR RAKETE_L,Z31  XOR = (a oder m) - (a und m)
6D4   ; F4             SUB TREFFER,Z31
05E   ; F5             MOV Z32,HILF     rechts
2CE   ; F6             AND RAKETE_R,HILF
AC5   ; F7             OR RAKETE_R,Z32
6E5   ; F8             SUB HILF,Z32
CE2   ; F9             GOTO TgEnde
F0D   ; FA  TgUp       EXRL             Zeile 5-8: Alienfenster auf
74A   ; FB             SUBI #4,RAKETE_Y
11F   ; FC             MOVI #1,FENSTER
CCC   ; FD             GOTO TgZeile
